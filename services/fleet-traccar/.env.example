GPS_BIND_IP=127.0.0.1
GPS_TCP_PORT=5027
GPS_ADMIN_PORT=18082
GPS_DOCKER_NETWORK=supabase_default
# Dedicated role in dedicated database on existing PostgreSQL, never Supabase's postgres database.
TRACCAR_RELAY_DSN=postgresql://vihem_traccar_relay:REPLACE@supabase-db:5432/vihem_traccar
VIHEM_INGEST_URL=https://supabase.asedatruckmeet.se/functions/v1/vihem-fleet-ingest
FLEET_TRACCAR_SECRET=REPLACE_WITH_RANDOM_64_HEX_SECRET
# Queue/Traccar position retention must match the organisation policy; never purge pending queue entries.
TRACCAR_RETENTION_DAYS=90

TRACCAR_API_URL=http://traccar:8082
TRACCAR_ADMIN_EMAIL=gps-integration@example.invalid
TRACCAR_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_ADMIN_PASSWORD
