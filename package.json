{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.config.ts",
    "lint": "eslint .",
    "test:rental": "node scripts/viborent-unit-check.mjs",
    "test:inventory": "node scripts/inventory-invariants-check.mjs",
    "test:skatteverket": "node scripts/skatteverket-check.mjs",
    "test:installments": "node scripts/installment-plan-check.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "release:check": "node scripts/check-release.mjs",
    "mobile:sync": "npm run mobile:build && npx cap sync",
    "mobile:ios": "npx cap open ios",
    "mobile:android": "npx cap open android",
    "viborent:dev": "vite --config apps/viborent/vite.config.ts",
    "viborent:build": "vite build --config apps/viborent/vite.config.ts",
    "viborent:preview": "vite preview --config apps/viborent/vite.config.ts",
    "test:mobile-bundle": "node scripts/check-mobile-web-build.mjs",
    "vibofast:build": "npm --prefix apps/vibofast run build",
    "ekangen:dev": "npm --prefix apps/ekangen run dev",
    "ekangen:build": "npm --prefix apps/ekangen install --no-audit --no-fund && npm --prefix apps/ekangen run build",
    "test:chat": "node scripts/chat-invariants-check.mjs",
    "test:chat:integration": "node scripts/chat-integration-check.mjs",
    "test:premium": "node scripts/premium/checks.mjs",
    "test:premium:profile": "node scripts/premium/profile-integration.mjs",
    "test:premium:workorders": "node scripts/premium/workorder-integration.mjs",
    "mobile:build": "node scripts/build-mobile-release.mjs",
    "test:mobile-release": "node scripts/check-mobile-release-config.mjs",
    "vibogruppen:build": "npm --prefix apps/vibogruppen run build",
    "vibogruppen:dev": "npm --prefix apps/vibogruppen run dev",
    "test:kp": "node scripts/kp-unit-check.mjs",
    "test:resources": "node scripts/staff-resources-check.mjs",
    "test:snow": "node scripts/snow-unit-check.mjs && node scripts/snow-availability-check.mjs",
    "test:workspace": "node scripts/personal-workspace/unit-test.mjs && node scripts/personal-workspace/local-test.mjs",
    "test:workspace:db": "python3 scripts/personal-workspace/database-test.py --fresh-test",
    "workspace:qa": "vite --config scripts/personal-workspace/qa/vite.config.ts",
    "test:mail": "node scripts/mail-unit-check.mjs",
    "test:mail:sql": "bash scripts/test_mail_sql.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capawesome/capacitor-badge": "^8.0.2",
    "@supabase/supabase-js": "^2.57.4",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/extension-unique-id": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/qrcode": "^1.5.6",
    "@zxing/browser": "0.1.5",
    "dompurify": "^3.2.5",
    "heic2any": "^0.0.4",
    "leaflet": "1.9.4",
    "lucide-react": "^0.344.0",
    "pdf-lib": "^1.17.1",
    "perfect-freehand": "^1.2.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/leaflet": "1.9.21",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "esbuild": "^0.28.2",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "fake-indexeddb": "^6.2.6",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
